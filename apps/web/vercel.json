{
  "buildCommand": "cd ../.. && npx turbo build --filter=web",
  "installCommand": "cd ../.. && pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/recordatorios-plazos",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/recordatorios-facturas",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/generar-facturas-recurrentes",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/auto-backup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/push-notifications",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recordatorios-cobro",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/alertas-inteligentes",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/generar-modelos-trimestrales",
      "schedule": "0 6 1 1,4,7,10 *"
    },
    {
      "path": "/api/cron/backup-semanal",
      "schedule": "0 2 * * 0"
    }
  ]
}
