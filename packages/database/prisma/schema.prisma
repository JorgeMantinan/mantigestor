generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model Perfil {
  id              String   @id
  userId          String   @unique
  email           String   @unique
  nombre          String?
  nif             String?
  comunidadFiscal String? // 'Madrid', 'País Vasco - Bizkaia', ... (nombre normalizado de COMUNIDADES)
  perfilFiscal    String? // 'autonomo' | 'sociedad' | 'empleado' | 'alquilador'
  notasPie        String? // notas pie de factura por defecto (una por línea)
  logoBase64      String? // logo de empresa en base64 data URL para facturas (max 500KB)
  firmaBase64     String? // firma digital en base64 JSON: {imagen, nombre, fecha, cargo}
  empresas          String? // JSON array de empresas: [{id,nombre,nif,direccion,activa}]
  idiomaFactura     String?  @default("es") // 'es' | 'en' — idioma de las facturas PDF
  monedaPorDefecto  String?  @default("EUR") // moneda por defecto del perfil
  // Datos personales para Declaración de la Renta (Modelo 100)
  situacionCivil          String?  // 'soltero' | 'casado' | 'divorciado' | 'viudo'
  fechaNacimiento         DateTime?
  numeroHijos             Int      @default(0)
  hijosEdades             String?  // JSON array de edades: [5, 12]
  tieneDiscapacidad       Boolean  @default(false)
  porcentajeDiscapacidad  Int      @default(0) // 0, 33, 65+
  familiaNumerosa         Boolean  @default(false)
  planPensiones           Int      @default(0) // céntimos
  segurosDependencia      Int      @default(0) // céntimos
  donaciones              Int      @default(0) // céntimos
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  facturas                   Factura[]
  documentos                 Documento[]
  suscripciones              Suscripcion[]
  notificaciones             Notificacion[]
  preferenciasNotificaciones PreferenciaNotificacion[]
  propiedadesAlquiler        PropiedadAlquiler[]
  nominas                    Nomina[]
  facturasRecurrentes        FacturaRecurrente[]
  auditLogs                  AuditLog[]
  pushSubscriptions          PushSubscription[]
  movimientosBanco           MovimientoBanco[]
  conciliacionLogs           ConciliacionLog[]
  chatHistorial              ChatHistorial[]
  plantillasFactura          PlantillaFactura[]
  encuestasSatisfaccion      EncuestaSatisfaccion[]

  @@map("perfiles")
}

model InvitacionPendiente {
  id                  String    @id
  email               String
  nombre              String?
  nif                 String?
  invitadoPorUserId   String
  invitadoPorEmail    String
  aceptada            Boolean   @default(false)
  rol                 String?
  tipo                String    @default("gestion") // 'gestion' | 'referido'
  createdAt           DateTime  @default(now())

  @@index([email])
  @@map("invitaciones_pendientes")
}

model PlantillaFactura {
  id             String   @id @default(cuid())
  perfilId       String
  perfil         Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  nombre         String
  tipo           String
  emisorReceptor String
  nifContraparte String?
  concepto       String?
  baseImponible  Int
  iva            Int      @default(21)
  categoriaGasto String?
  createdAt      DateTime @default(now())

  @@index([perfilId])
  @@map("plantillas_factura")
}

model FacturaRecurrente {
  id               String    @id @default(cuid())
  perfilId         String
  perfil           Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tipo             String
  numero           String
  emisorReceptor   String
  nifContraparte   String?
  baseImponible    Int // en céntimos
  iva              Int // 0, 4, 10 o 21
  diaGeneracion    Int // día del mes (1-28)
  diaEmail         Int? // día del mes para enviar email recordatorio
  activa           Boolean   @default(true)
  ultimaGeneracion DateTime?
  notas            String?
  createdAt        DateTime  @default(now())

  @@index([perfilId])
  @@map("facturas_recurrentes")
}

model PerfilAsociado {
  id          String   @id @default(uuid())
  ownerUserId String // auth.users id del gestor
  perfilId    String // perfiles.id de la persona gestionada
  rol         String   @default("gestor") // "propietario" | "gestor" | "visualizador"
  createdAt   DateTime @default(now())

  @@unique([ownerUserId, perfilId])
  @@index([ownerUserId])
  @@index([perfilId])
  @@map("perfil_asociado")
}

model Factura {
  id                  String    @id @default(cuid())
  perfilId            String
  perfil              Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  empresaId           String? // ID de la empresa (JSON en perfil.empresas)
  numero              String
  tipo                String // 'ingreso' | 'gasto' | 'proforma'
  emisorReceptor      String
  nifContraparte      String?
  fechaEmision        DateTime
  fechaVencimiento    DateTime?
  baseImponible       Int // en céntimos
  iva                 Int // 0, 4, 10 o 21
  total               Int // en céntimos
  estado              String    @default("pendiente") // facturas: pendiente|pagada|vencida; proformas: borrador|enviada|aceptada|rechazada
  // proformaEstado String?  // campo dedicado si se separa proformas de facturas en el futuro
  descuentoPorcentaje Float     @default(0)
  categoriaGasto      String? // etiqueta: suministros, alquiler, nomina, seguridad, marketing, otros
  notas               String? // notas internas sobre la factura
  notasPrivadas       String? // notas privadas del gestor (no visibles al cliente)
  tags                String? // etiquetas separadas por coma: marketing,software,custom
  deducible           Boolean? @default(true) // false si el gasto no es deducible fiscalmente
  pdfUrl              String?
  tokenCliente        String? // token compartido para portal de cliente (mismo token = mismo cliente)
  moneda              String    @default("EUR") // código ISO 4217: EUR, USD, GBP, etc.
  tipoCambio          Float     @default(1.0) // tasa de cambio vs EUR (1.0 si es EUR)
  pagosParciales      String? // JSON array de pagos parciales [{id, fecha, importe, metodo, notas}]
  createdAt           DateTime  @default(now())

  movimientosBanco MovimientoBanco[]
  conciliacionLogs ConciliacionLog[]

  @@index([perfilId, tipo])
  @@index([perfilId, fechaEmision])
  @@index([perfilId, estado, fechaVencimiento])
  @@index([tokenCliente])
  @@index([empresaId])
  @@map("facturas")
}

model Proforma {
  id             String   @id
  perfilId       String
  numero         String
  clienteNombre  String
  clienteNif     String?
  fecha          DateTime
  validezDias    Int      @default(30)
  concepto       String
  baseImponible  Int
  iva            Int
  total          Int
  estado         String   @default("borrador")
  notas          String?
  createdAt      DateTime @default(now())

  @@index([perfilId])
  @@map("proformas")
}

model ModeloGenerado {
  id           String   @id
  perfilId     String
  modelo       String // '303' | '111' | '130' (trimestrales); reservado para anuales
  titulo       String   @default("")
  periodicidad String   @default("trimestral") // trimestral | anual | mensual
  trimestre    Int      @default(0) // 1-4; 0 = anual
  anyo         Int
  fingerprint  String // huella estable de los datos de entrada
  totalCents   Int      @default(0) // importe principal en céntimos
  datos        Json // resumen numérico del cálculo (céntimos)
  estado       String   @default("borrador") // borrador | listo | presentado
  generadoEn   DateTime @default(now())

  @@unique([perfilId, modelo, anyo, trimestre])
  @@index([perfilId, anyo])
  @@map("modelos_generados")
}

model Nomina {
  id              String   @id @default(cuid())
  perfilId        String
  perfil          Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  empresaId       String? // ID de la empresa (JSON en perfil.empresas)
  empleada        String
  mes             Int
  anyo            Int
  salarioBruto    Int // en céntimos
  irpf            Float // porcentaje (ej: 15.0)
  seguridadSocial Int      @default(0)
  neto            Int // en céntimos
  rol             String // 'jefe' | 'empleado'
  pdfUrl          String?
  createdAt       DateTime @default(now())

  @@index([perfilId, anyo])
  @@index([empresaId])
  @@map("nominas")
}

model Documento {
  id          String   @id @default(cuid())
  perfilId    String
  perfil      Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  empresaId   String? // ID de la empresa (JSON en perfil.empresas)
  tipo        String // 'alumno', 'factura', 'trimestre', 'alquiler', 'nomina'
  nombre      String
  tamanoBytes Int?
  url         String
  subidoEn    DateTime @default(now())

  @@index([perfilId])
  @@index([empresaId])
  @@map("documentos")
}

model Suscripcion {
  id                     String    @id @default(cuid())
  perfilId               String
  perfil                 Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tier                   String // 'BASIC' | 'PRO'
  provider               String // 'stripe' | 'paypal'
  providerSubscriptionId String    @unique
  estado                 String
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())

  @@index([perfilId])
  @@map("suscripciones")
}

model Notificacion {
  id        String   @id @default(cuid())
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tipo      String
  leido     Boolean  @default(false)
  contenido String
  creadoEn  DateTime @default(now())

  @@index([perfilId, leido])
  @@index([perfilId, creadoEn])
  @@map("notificaciones")
}

model PreferenciaNotificacion {
  id             String   @id @default(cuid())
  perfilId       String
  perfil         Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  canal          String   @default("in_app") // 'in_app' | 'email'
  categoria      String // 'iva' | 'irpf' | 'retenciones' | 'renta' | 'todos'
  diasAntelacion Int      @default(15)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([perfilId, canal, categoria])
  @@map("preferencias_notificaciones")
}

model PropiedadAlquiler {
  id                    String    @id @default(cuid())
  perfilId              String
  perfil                Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  empresaId             String? // ID de la empresa (JSON en perfil.empresas)
  direccion             String
  ingresos              Int       @default(0)
  inquilinoNombre       String?
  inquilinoNif          String?
  inquilinoEmail        String?
  inquilinoTelefono     String?
  fechaInicioContrato   DateTime?
  duracionContratoMeses Int?
  proximaRevision       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  gastos GastoAlquiler[]

  @@index([perfilId])
  @@index([empresaId])
  @@map("propiedades_alquiler")
}

model GastoAlquiler {
  id          String            @id @default(cuid())
  propiedadId String
  propiedad   PropiedadAlquiler @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  concepto    String
  descripcion String?
  importe     Int
  fecha       DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@index([propiedadId])
  @@map("gastos_alquiler")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  perfil    Perfil?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================
// DATASET FISCAL ESPAÃ‘A â€” capas raw/staging/production unificadas.
// Regla: production_allowed solo con status = OFFICIAL_VERIFIED.
// =============================================================

model FiscalSource {
  id                 String    @id // SRC_BOE_HAC_1526_2024
  authority          String // BOE, AEAT, Seguridad Social...
  title              String
  sourceType         String // BOE | OFFICIAL_MODEL | OFFICIAL_GUIDE | ...
  url                String?
  documentUrl        String?
  publicationDate    DateTime?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  taxYear            Int?
  retrievedAt        DateTime? // fecha de captura del dato
  verificationStatus String    @default("OFFICIAL_UNVERIFIED")
  notes              String?

  taxModels                TaxModel[]
  deadlines                Deadline[]
  fiscalRates              FiscalRate[]
  irpfTramosEstatales      IrpfTramoEstatal[]
  irpfTramosAutonomicos    IrpfTramoAutonomico[]
  retaTramos               RetaTramo[]
  cotizaciones             CotizacionSegSocial[]
  isTipos                  IsTipo[]
  vatRules                 VatRule[]
  minimosPersonales        MinimoPersonalFamiliar[]
  reduccionesIrpf          ReduccionGeneralIrpf[]
  isdReglas                IsdRegla[]
  itpAjdReglas             ItpAjdRegla[]
  patrimonioEscalas        PatrimonioEscala[]
  deduccionesAutonomicas   DeduccionAutonomica[]
  patrimonioBonificaciones PatrimonioBonificacion[]
  sanciones                Sancion[]
  amortizaciones           AmortizacionDietaKm[]
  umbrales                 UmbralTamanoEmpresa[]
  reglasTerritoriales      ReglaTerritorial[]

  @@map("fiscal_sources")
}

model Jurisdiction {
  id      String  @id // ES-TC, ES-PV-AR, ES-PV-BI, ES-PV-SS, ES-NA, ES-GA...
  name    String
  type    String // STATE | AUTONOMOUS_COMMUNITY | FORAL_TERRITORY | AUTONOMOUS_CITY | PROVINCIAL_FORAL
  country String  @default("España")
  active  Boolean @default(true)

  administrations    Administration[]
  reglasTeritoriales ReglaTerritorial[]

  @@map("jurisdicciones")
}

model Administration {
  id             String       @id // ADM_AEAT, ADM_BI, ADM_NA...
  name           String
  type           String // STATE | AUTONOMOUS | FORAL
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  @@map("administraciones")
}

// Estados: DRAFT | RESEARCH | SECONDARY_SOURCE | OFFICIAL_UNVERIFIED |
// OFFICIAL_VERIFIED | SUPERSEDED | EXPIRED (tabla de catálogo + campo status en cada entidad)
model EstadoVerificacion {
  status            String  @id
  productionAllowed Boolean
  definition        String

  @@map("estados_verificacion")
}

model AuditoriaCorreccion {
  id             String    @id
  archivo        String
  hoja           String?
  fila           Int?
  campo          String?
  valorOriginal  String?
  valorCorregido String?
  motivo         String?
  fecha          DateTime?
  nuevoEstado    String? // new_status del CSV de auditoría
  reemplazo      String? // replacement (p.ej. MOD037 → MOD036)
  sourceId       String?

  @@map("auditoria_correcciones")
}

model TaxModel {
  // Clave lógica: administrationId + modelNumber + taxYear + version
  id                  String        @id @default(cuid())
  modelNumber         String // MOD036, MOD303...
  nombreOficial       String
  categoria           String // Censal | IVA | IRPF | IS | Retenciones...
  organismo           String
  administrationId    String?
  aplicaAutonomo      Boolean?
  aplicaPymeSl        Boolean?
  aplicaEmpresaGrande Boolean?
  periodicidad        String?
  plazoPresentacion   String?
  umbralObligacion    String?
  descripcionBreve    String?
  urlOficial          String?
  taxYear             Int?
  applicationYear     Int?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  version             Int           @default(1)
  status              String        @default("OFFICIAL_UNVERIFIED")
  replacementModel    String? // p.ej. MOD037 â†’ MOD036
  sourceId            String?
  source              FiscalSource? @relation(fields: [sourceId], references: [id])
  productionEligible  Boolean       @default(false)
  verificationNotes   String?

  deadlines Deadline[]

  @@unique([administrationId, modelNumber, taxYear, version])
  @@index([modelNumber])
  @@map("tax_models")
}

model FiscalRate {
  // Porcentajes y tipos genéricos (02_porcentajes_y_tipos.csv y similares)
  id                  String        @id
  modeloRelacionado   String? // MOD303...
  concepto            String
  valor               Decimal       @db.Decimal(9, 4)
  baseCalculo         String?
  condicionAplicacion String?
  vigenteDesde        Int? // año
  vigenteHasta        Int?
  taxYear             Int?
  jurisdictionId      String? // null = estatal / territorio común
  notes               String?
  fuenteUrl           String?
  sourceId            String?
  source              FiscalSource? @relation(fields: [sourceId], references: [id])
  status              String        @default("OFFICIAL_UNVERIFIED")

  @@index([concepto])
  @@map("fiscal_rates")
}

model IrpfTramoEstatal {
  id                  String        @id
  tramo               Int
  desdeEur            Decimal       @db.Decimal(12, 2)
  hastaEur            Decimal? // null = sin límite
  tipoEstatalPct      Decimal       @db.Decimal(5, 2)
  tipoCombinadoRefPct Decimal       @db.Decimal(5, 2)
  taxYear             Int
  nota                String?
  sourceId            String?
  source              FiscalSource? @relation(fields: [sourceId], references: [id])
  status              String        @default("OFFICIAL_UNVERIFIED")

  @@unique([tramo, taxYear])
  @@map("irpf_tramos_estatales")
}

model IrpfTramoAutonomico {
  id                String        @id
  comunidad         String // Andalucía, Aragón... (nombre normalizado)
  jurisdictionId    String? // ES-AN...
  tramo             Int
  desdeEur          Decimal       @db.Decimal(12, 2)
  hastaEur          Decimal?
  tipoAutonomicoPct Decimal       @db.Decimal(5, 2)
  regimen           String        @default("Común") // Común | Foral Álava | Foral Bizkaia | Foral Gipuzkoa | Navarra
  taxYear           Int
  confianza         String?
  notas             String?
  fuenteTexto       String?
  sourceId          String?
  source            FiscalSource? @relation(fields: [sourceId], references: [id])
  status            String        @default("OFFICIAL_UNVERIFIED")

  @@unique([comunidad, tramo, taxYear])
  @@map("irpf_tramos_autonomicos")
}

model IrpfTramoAhorro {
  id          String   @id
  territorio  String // 'Común' | 'País Vasco - Álava' | ... | 'Navarra (Comunidad Foral de)'
  tramo       Int
  desdeEur    Decimal  @db.Decimal(12, 2)
  hastaEur    Decimal?
  tipoPct     Decimal  @db.Decimal(5, 2)
  regimen     String   @default("Comun")
  taxYear     Int
  notas       String?
  fuenteTexto String?
  status      String   @default("OFFICIAL_UNVERIFIED")

  @@unique([territorio, tramo, taxYear])
  @@map("irpf_tramos_ahorro")
}

model RetaTramo {
  id                   String        @id
  tabla                String // Reducida | General...
  tramo                Int
  rendimientoNetoDesde Decimal       @db.Decimal(10, 2)
  rendimientoNetoHasta Decimal?
  baseMinimaEur        Decimal       @db.Decimal(10, 2)
  baseMaximaEur        Decimal?
  cuotaMinimaRefEur    Decimal?      @db.Decimal(10, 2)
  confianza            String?
  fuenteTexto          String?
  taxYear              Int
  status               String        @default("OFFICIAL_UNVERIFIED")
  productionNote       String?
  sourceId             String?
  source               FiscalSource? @relation(fields: [sourceId], references: [id])

  @@unique([tabla, tramo, taxYear])
  @@map("reta_tramos")
}

model CotizacionSegSocial {
  id             String        @id
  regimen        String
  concepto       String
  // Nullable: conceptos parciales del dataset (p.ej. MEI solo aplica a una parte)
  pctEmpresa     Decimal?      @db.Decimal(5, 2)
  pctTrabajador  Decimal?      @db.Decimal(5, 2)
  pctTotal       Decimal?      @db.Decimal(5, 2)
  baseReferencia String?
  taxYear        Int
  status         String        @default("OFFICIAL_UNVERIFIED")
  productionNote String?
  sourceId       String?
  source         FiscalSource? @relation(fields: [sourceId], references: [id])

  @@unique([regimen, concepto, taxYear])
  @@map("cotizaciones_seg_social")
}

model IsTipo {
  id                   String        @id
  tipoEntidad          String
  requisitoFacturacion String?
  tipoPct              Decimal       @db.Decimal(5, 2)
  taxYear              Int // año del tipo (2025/2026); previsiones futuras van como filas DRAFT/RESEARCH
  previsto             Boolean       @default(false) // true para columnas *_previsto
  notas                String?
  status               String        @default("OFFICIAL_UNVERIFIED")
  productionNote       String?
  sourceId             String?
  source               FiscalSource? @relation(fields: [sourceId], references: [id])

  @@unique([tipoEntidad, taxYear])
  @@map("is_tipos")
}

model DeduccionAutonomica {
  id                 String        @id
  taxYear            Int
  comunidad          String
  tipo               String // nacimiento, ascendientes, discapacidad, alquiler, guarderia, etc.
  descripcion        String
  importeBaseCents   Int? // cantidad fija en céntimos (ej: 72170 = 721,70€)
  porcentaje         Decimal?      @db.Decimal(5, 2) // % sobre gasto/base (ej: 20.00 para 20%)
  importeMaxCents    Int? // tope máximo anual de la deducción en céntimos
  rentaMinimaCents   Int? // base imponible mínima para aplicación plena
  rentaMaximaCents   Int? // base imponible máxima (hasta la que se reduce linealmente)
  duplicable         Boolean       @default(false) // true si se duplica con discapacidad ≥33%
  incompatibilidades String? // IDs o tipos de deducciones incompatibles
  periodoAplicacion  String? // "nacimiento+2", "anual", etc.
  notas              String? // condiciones específicas,.umbral de renta de descendiente, etc.
  status             String        @default("OFFICIAL_UNVERIFIED")
  productionNote     String?
  sourceId           String?
  source             FiscalSource? @relation(fields: [sourceId], references: [id])

  @@unique([comunidad, tipo, descripcion, taxYear])
  @@map("deducciones_autonomicas")
}

model PatrimonioBonificacion {
  id              String        @id
  taxYear         Int
  comunidad       String
  descripcion     String
  porcentajeCents Int // porcentaje de bonificación en céntimos (10000 = 100%)
  importeMaxCents Int? // tope máximo de bonificación en céntimos (null = sin tope)
  condiciones     String? // condiciones específicas
  notas           String? // notas adicionales (anti-ITSGF, etc.)
  status          String        @default("OFFICIAL_UNVERIFIED")
  productionNote  String?
  sourceId        String?
  source          FiscalSource? @relation(fields: [sourceId], references: [id])

  @@unique([comunidad, taxYear])
  @@map("patrimonio_bonificaciones")
}

model Deadline {
  id                    String        @id @default(cuid())
  modeloNumero          String? // MOD303...
  modeloId              String?
  modelo                TaxModel?     @relation(fields: [modeloId], references: [id])
  periodo               String // Enero-Marzo, 1T...
  periodType            String // TRIMESTRAL | MENSUAL | ANUAL | PUNTUAL
  deadlineType          String // RULE_REVIEW_REQUIRED | FECHA_FIJA | ...
  deadlineRule          String?
  deadlineRuleJson      Json?
  fechaLimiteReferencia DateTime? // referencia 2026 del CSV corregido
  diasAvisoRecomendados String?
  aplicaA               String?
  taxYear               Int
  effectiveFrom         DateTime?
  effectiveTo           DateTime?
  jurisdictionId        String?
  sourceId              String?
  source                FiscalSource? @relation(fields: [sourceId], references: [id])
  status                String        @default("OFFICIAL_UNVERIFIED")
  productionNote        String?

  @@index([modeloNumero, taxYear])
  @@map("deadlines")
}

model VatRule {
  id              String        @id @default(cuid())
  tipo            String // General | Reducido | Superreducido | Cero | Exento
  ratePct         Decimal       @db.Decimal(5, 2)
  productCategory String?
  operationType   String?
  recipientType   String?
  territory       String? // ES-TC o jurisdicción foral
  ejemplos        String?
  conditionsJson  Json?
  exceptionsJson  Json?
  taxYear         Int?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  sourceId        String?
  source          FiscalSource? @relation(fields: [sourceId], references: [id])
  status          String        @default("OFFICIAL_UNVERIFIED")

  @@index([tipo, taxYear])
  @@map("vat_rules")
}

