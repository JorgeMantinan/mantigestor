generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model Perfil {
  id              String   @id
  userId          String   @unique
  email           String   @unique
  nombre          String?
  nif             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facturas       Factura[]
  documentos     Documento[]
  examenes       Examen[]
  suscripciones  Suscripcion[]
  notificaciones     Notificacion[]
  propiedadesAlquiler PropiedadAlquiler[]

  @@map("perfiles")
}

model Factura {
  id              String   @id @default(cuid())
  perfilId        String
  perfil          Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  numero          String
  tipo            String   // 'ingreso' | 'gasto'
  emisorReceptor  String
  nifContraparte  String?
  fechaEmision    DateTime
  fechaVencimiento DateTime?
  baseImponible   Int      // en céntimos
  iva             Int      // 0, 4, 10 o 21
  total           Int      // en céntimos
  estado          String   @default("pendiente")
  pdfUrl          String?
  createdAt       DateTime @default(now())

  @@index([perfilId, tipo])
  @@index([perfilId, fechaEmision])
  @@map("facturas")
}

model Documento {
  id          String   @id @default(cuid())
  perfilId    String
  perfil      Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tipo        String   // 'alumno', 'factura', 'trimestre', 'alquiler', 'nomina'
  nombre      String
  tamanoBytes Int?
  url         String
  subidoEn    DateTime @default(now())

  @@map("documentos")
}

model Examen {
  id          String    @id @default(cuid())
  perfilId    String
  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tipo        String    // 'facturas', 'trimestres', 'alquiler', 'nominas', 'alumnos'
  estado      String    @default("pendiente")
  resultado   String?
  creadoEn    DateTime  @default(now())
  completadoEn DateTime?

  @@map("examenes")
}

model Suscripcion {
  id                     String   @id @default(cuid())
  perfilId               String
  perfil                 Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tier                   String   // 'BASIC' | 'PRO'
  provider               String   // 'stripe' | 'paypal'
  providerSubscriptionId String   @unique
  estado                 String
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime?
  createdAt              DateTime @default(now())

  @@map("suscripciones")
}

model Notificacion {
  id        String   @id @default(cuid())
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  tipo      String
  leido     Boolean  @default(false)
  contenido String
  creadoEn  DateTime @default(now())

  @@index([perfilId, leido])
  @@map("notificaciones")
}

model PropiedadAlquiler {
  id               String   @id @default(cuid())
  perfilId         String
  perfil           Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  direccion        String
  ingresos         Int      @default(0)
  inquilinoNombre  String?
  inquilinoEmail   String?
  inquilinoTelefono String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gastos GastoAlquiler[]

  @@map("propiedades_alquiler")
}

model GastoAlquiler {
  id          String   @id @default(cuid())
  propiedadId String
  propiedad   PropiedadAlquiler @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  concepto    String
  descripcion String?
  importe     Int
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("gastos_alquiler")
}
