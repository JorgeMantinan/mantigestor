// =============================================================
// IMPORTACIÃ“N â€” log y calidad de datos
// =============================================================

model ImportRun {
  id           String    @id @default(cuid()) // run_id
  file         String
  sheet        String?
  rowsRead     Int       @default(0)
  rowsInserted Int       @default(0)
  rowsUpdated  Int       @default(0)
  rowsRejected Int       @default(0)
  errorsJson   Json?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([file])
  @@map("import_log")
}

model DataQualityError {
  id         String  @id @default(cuid())
  runId      String
  sourceFile String
  rowNumber  Int?
  field      String?
  value      String?
  errorCode  String
  message    String
  severity   String  @default("ERROR") // ERROR | WARNING
  resolved   Boolean @default(false)

  @@index([runId])
  @@map("data_quality_errors")
}

model AuditLog {
  id        String   @id @default(cuid())
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  accion    String // 'crear' | 'editar' | 'eliminar' | 'cambio_estado'
  entidad   String // 'factura' | 'propiedad' | 'nomina' | 'alumno' | 'suscripcion'
  entidadId String?
  detalle   String? // descripción legible de la acción
  meta      String? // JSON con datos adicionales (campos cambiados, estado anterior/nuevo)
  createdAt DateTime @default(now())

  @@index([perfilId])
  @@index([createdAt])
  @@index([perfilId, createdAt])
  @@map("audit_log")
}

model VersionRegistro {
  id        String   @id @default(cuid())
  perfilId  String
  entidad   String
  entidadId String
  version   Int
  datos     Json
  usuarioId String
  creadoEn  DateTime @default(now())

  @@index([perfilId])
  @@index([entidad, entidadId])
  @@map("versiones_registro")
}

model MovimientoBanco {
  id            String   @id @default(cuid())
  perfilId      String
  perfil        Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  fecha         DateTime
  concepto      String
  importe       Int      // cents
  saldo         Int      // cents
  referencia    String?
  categoria     String?  // 'ingreso' | 'gasto' | 'transferencia'
  conciliado    Boolean  @default(false)
  facturaId     String?  // linked invoice
  createdAt     DateTime @default(now())

  factura Factura? @relation(fields: [facturaId], references: [id], onDelete: SetNull)
  conciliacionLogs ConciliacionLog[]

  @@index([perfilId])
  @@index([facturaId])
  @@map("movimientos_banco")
}

model ConciliacionLog {
  id            String   @id @default(cuid())
  perfilId      String
  perfil        Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  movimientoId  String
  movimiento    MovimientoBanco @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  facturaId     String
  factura       Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  puntuacion    Int      // matching score
  accion        String   // 'auto' | 'manual'
  creadoEn      DateTime @default(now())

  @@index([perfilId])
  @@index([facturaId])
  @@map("conciliacion_logs")
}

model EncuestaSatisfaccion {
  id            String    @id @default(cuid())
  perfilId      String
  perfil        Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  clienteNombre String
  clienteEmail  String?
  puntuacion    Int
  comentario    String?
  creadoEn      DateTime  @default(now())

  @@index([perfilId])
  @@map("encuestas_satisfaccion")
}

model ChatHistorial {
  id        String   @id @default(cuid())
  perfilId  String
  perfil    Perfil   @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  rol       String
  contenido String
  creadoEn  DateTime @default(now())

  @@index([perfilId])
  @@map("chat_historial")
}
